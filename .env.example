# Bingo Card Generator - Environment Variables Template
# Copy this file to .env and fill in your values

# Flask Configuration
FLASK_ENV=production
FLASK_DEBUG=False
SECRET_KEY=your-secret-key-here-change-this-in-production

# Server Configuration
HOST=0.0.0.0
PORT=8080

# AWS Configuration (for deployment)
AWS_REGION=us-west-2
ECR_REPOSITORY_URI=123456789012.dkr.ecr.us-west-2.amazonaws.com/bingo-app
EC2_INSTANCE_ID=i-1234567890abcdef0

# Optional: Custom paths (defaults will be used if not set)
# BINGO_CSV_PATH=/path/to/your/bingo-tiles.csv
# IMAGES_DIR=/path/to/your/images

# Logging Level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Docker Configuration
CONTAINER_NAME=bingo-app
DOCKER_TAG=latest

# Security Notes:
# - Never commit .env files with real secrets to version control
# - Use AWS IAM roles instead of hardcoded credentials when possible
# - Generate a strong SECRET_KEY for Flask sessions
# - Consider using AWS Parameter Store or Secrets Manager for production